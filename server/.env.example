# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
DATABASE_FILE=discover-morocco.db
# Adresse du front-end Vite autorisée à appeler l'API (en développement)
CORS_ORIGIN=http://localhost:5173
# Connexion avec Google (facultatif) : identifiant client OAuth « Application Web » créé dans Google Cloud.
# Laissé vide, le bouton « Continuer avec Google » n'apparaît pas.
GOOGLE_CLIENT_ID=
